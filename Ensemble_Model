class SceneDataset(Dataset):
    def __init__(self, df, img_dir, transform=None, is_test=False):
        self.df        = df.reset_index(drop=True)
        self.img_dir   = img_dir
        self.transform = transform
        self.is_test   = is_test

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):
        img_name = self.df.loc[idx, "ImageName"]
        image    = Image.open(os.path.join(self.img_dir, img_name)).convert("RGB")
        if self.transform:
            image = self.transform(image)
        if self.is_test:
            return image, img_name
        return image, int(self.df.loc[idx, "ClassLabel"])


def build_dataframe(root_dir):
    records = []
    for class_name, label in LABEL_MAP.items():
        class_dir = os.path.join(root_dir, class_name)
        if not os.path.isdir(class_dir):
            continue
        for fname in os.listdir(class_dir):
            if fname.lower().endswith((".jpg", ".jpeg", ".png")):
                records.append({"ImageName": os.path.join(class_name, fname),
                                 "ClassLabel": label})
    df = pd.DataFrame(records)
    print(f"Total training images: {len(df)}")
    return df


def compute_class_weights(df):
    counts    = Counter(df["ClassLabel"].tolist())
    max_count = max(counts.values())
    weights   = [min(max_count / counts.get(i, 1), 4.0) for i in range(NUM_CLASSES)]
    return torch.FloatTensor(weights).to(DEVICE)


def _head(in_features):
    return nn.Sequential(
        nn.Linear(in_features, 768),
        nn.LayerNorm(768),
        nn.GELU(),
        nn.Dropout(0.35),
        nn.Linear(768, 256),
        nn.GELU(),
        nn.Dropout(0.2),
        nn.Linear(256, NUM_CLASSES),
    )


def wrap_model(model):
    return model.to(DEVICE)

def unwrap(model):
    return model.module if isinstance(model, nn.DataParallel) else model


def create_convnext():
    model = models.convnext_large(weights=models.ConvNeXt_Large_Weights.DEFAULT)
    in_f  = model.classifier[2].in_features
    model.classifier[2] = _head(in_f)
    return wrap_model(model)


def create_efficientnet():
    model = models.efficientnet_v2_l(weights=models.EfficientNet_V2_L_Weights.DEFAULT)
    in_f  = model.classifier[1].in_features
    model.classifier = nn.Sequential(
        nn.Dropout(0.4),
        nn.Linear(in_f, 768),
        nn.SiLU(),
        nn.Dropout(0.3),
        nn.Linear(768, 256),
        nn.SiLU(),
        nn.Dropout(0.2),
        nn.Linear(256, NUM_CLASSES),
    )
    return wrap_model(model)


def create_swin():
    model = models.swin_v2_b(weights=models.Swin_V2_B_Weights.DEFAULT)
    in_f  = model.head.in_features
    model.head = _head(in_f)
    return wrap_model(model)


def create_vit():
    if not HAS_TIMM:
        raise RuntimeError("pip install timm")
    model = timm.create_model('vit_large_patch16_224', pretrained=True,
                               num_classes=0, drop_path_rate=0.2)
    in_f  = model.num_features
    class ViTWrapper(nn.Module):
        def __init__(self, backbone, head):
            super().__init__()
            self.backbone = backbone
            self.head     = head
        def forward(self, x):
            return self.head(self.backbone(x))
    return wrap_model(ViTWrapper(model, _head(in_f)))


BACKBONES = {
    "convnext":     create_convnext,
    "efficientnet": create_efficientnet,
}
