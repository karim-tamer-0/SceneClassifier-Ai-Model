class SmoothCrossEntropy(nn.Module):
    def __init__(self, smoothing=LABEL_SMOOTH, weight=None):
        super().__init__()
        self.smoothing = smoothing
        self.weight    = weight

    def forward(self, pred, target):
        n = pred.size(1)
        with torch.no_grad():
            smooth = torch.full_like(pred, self.smoothing / (n - 1))
            smooth.scatter_(1, target.unsqueeze(1), 1.0 - self.smoothing)
        log_prob = F.log_softmax(pred, dim=1)
        if self.weight is not None:
            loss = -(smooth * log_prob)
            w    = self.weight[target].unsqueeze(1)
            loss = (loss * w).sum(dim=1).mean()
        else:
            loss = -(smooth * log_prob).sum(dim=1).mean()
        return loss


def mixup_data(x, y):
    lam   = np.random.beta(MIXUP_ALPHA, MIXUP_ALPHA)
    index = torch.randperm(x.size(0)).to(DEVICE)
    return lam * x + (1 - lam) * x[index], y, y[index], lam


def rand_bbox(size, lam):
    W, H  = size[2], size[3]
    cut_w = int(W * math.sqrt(1 - lam))
    cut_h = int(H * math.sqrt(1 - lam))
    cx    = random.randint(0, W)
    cy    = random.randint(0, H)
    return (max(cx - cut_w//2, 0), max(cy - cut_h//2, 0),
            min(cx + cut_w//2, W), min(cy + cut_h//2, H))


def cutmix_data(x, y):
    lam             = np.random.beta(CUTMIX_ALPHA, CUTMIX_ALPHA)
    index           = torch.randperm(x.size(0)).to(DEVICE)
    x1, y1, x2, y2 = rand_bbox(x.size(), lam)
    x_mix           = x.clone()
    x_mix[:, :, x1:x2, y1:y2] = x[index, :, x1:x2, y1:y2]
    lam_adj         = 1 - (x2-x1)*(y2-y1) / (x.size(2)*x.size(3))
    return x_mix, y, y[index], lam_adj


def mixed_criterion(criterion, pred, ya, yb, lam):
    return lam * criterion(pred, ya) + (1 - lam) * criterion(pred, yb)


def get_lr_lambda(epoch):
    warmup = 3
    if epoch < warmup:
        return (epoch + 1) / warmup
    progress = (epoch - warmup) / max(EPOCHS - warmup, 1)
    return 0.5 * (1 + math.cos(math.pi * progress))


def get_param_groups(backbone_name, model):
    raw = unwrap(model)
    if backbone_name in ("convnext", "efficientnet"):
        bp = list(raw.features.parameters())
        hp = list(raw.classifier.parameters())
    elif backbone_name == "swin":
        bp = [p for n, p in raw.named_parameters() if 'head' not in n]
        hp = list(raw.head.parameters())
    elif backbone_name == "vit":
        bp = list(raw.backbone.parameters())
        hp = list(raw.head.parameters())
    else:
        return [{'params': raw.parameters(), 'lr': 2e-4}]

    n = len(bp); t = n // 3
    return [
        {'params': bp[:t],    'lr': 5e-6},
        {'params': bp[t:2*t], 'lr': 1e-5},
        {'params': bp[2*t:],  'lr': 3e-5},
        {'params': hp,        'lr': 2e-4},
    ]


def make_loader(dataset, batch_size, shuffle):
    return DataLoader(
        dataset,
        batch_size=batch_size,
        shuffle=shuffle,
        num_workers=2,
        pin_memory=True,
        persistent_workers=False,
    )


def train_fold(backbone_name, fold, train_idx, val_idx, df, class_weights):
    print(f"\n{'─'*60}")
    print(f"  [{backbone_name.upper()}] FOLD {fold+1}/{NUM_FOLDS}")
    print(f"{'─'*60}")

    train_df = df.iloc[train_idx].reset_index(drop=True)
    val_df   = df.iloc[val_idx].reset_index(drop=True)

    bs           = BATCH_SIZE * NUM_GPUS
    train_loader = make_loader(SceneDataset(train_df, TRAIN_DIR, train_transform), bs, True)
    val_loader   = make_loader(SceneDataset(val_df,   TRAIN_DIR, val_transform),   bs, False)

    print(f"  Loaders ready — {len(train_loader)} train batches, {len(val_loader)} val batches")

    model     = BACKBONES[backbone_name]()
    criterion = SmoothCrossEntropy(weight=class_weights)
    optimizer = optim.AdamW(get_param_groups(backbone_name, model), weight_decay=1e-2)
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, lr_lambda=get_lr_lambda)
    scaler    = torch.amp.GradScaler('cuda')

    print(f"  Model ready — starting epochs…")

    best_val_acc = 0.0
    best_weights = None
    patience_ctr = 0
    patience     = 10

    for epoch in range(EPOCHS):
        model.train()
        train_correct = train_total = 0
        aug_type = "---"

        for images, labels in train_loader:
            images, labels = images.to(DEVICE), labels.to(DEVICE)

            r = random.random()
            if epoch >= 4 and r < 0.40:
                images, ya, yb, lam = cutmix_data(images, labels)
                aug_type = "cut"
            elif epoch >= 4 and r < 0.70:
                images, ya, yb, lam = mixup_data(images, labels)
                aug_type = "mix"
            else:
                ya, yb, lam = labels, labels, 1.0
                aug_type = "---"

            optimizer.zero_grad(set_to_none=True)
            with torch.amp.autocast('cuda'):
                out  = model(images)
                loss = mixed_criterion(criterion, out, ya, yb, lam)

            if not torch.isfinite(loss):
                print(f"    ⚠ Non-finite loss at epoch {epoch+1}, skipping batch")
                continue

            scaler.scale(loss).backward()
            scaler.unscale_(optimizer)
            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            scaler.step(optimizer)
            scaler.update()

            train_correct += (out.detach().argmax(1) == labels).sum().item()
            train_total   += labels.size(0)

        model.eval()
        val_correct = val_total = val_loss_sum = 0
        with torch.no_grad():
            for images, labels in val_loader:
                images, labels = images.to(DEVICE), labels.to(DEVICE)
                with torch.amp.autocast('cuda'):
                    out = model(images)
                val_loss_sum += criterion(out, labels).item() * labels.size(0)
                val_correct  += (out.argmax(1) == labels).sum().item()
                val_total    += labels.size(0)

        train_acc = train_correct / max(train_total, 1) * 100
        val_acc   = val_correct   / max(val_total,   1) * 100
        val_loss  = val_loss_sum  / max(val_total,   1)
        cur_lr    = optimizer.param_groups[-1]['lr']
        scheduler.step()

        print(f"  E{epoch+1:02d} [{aug_type}] Train:{train_acc:.1f}%  "
              f"Val:{val_acc:.1f}%  Loss:{val_loss:.4f}  LR:{cur_lr:.2e}")

        if val_acc > best_val_acc:
            best_val_acc = val_acc
            best_weights = copy.deepcopy(unwrap(model).state_dict())
            patience_ctr = 0
            save_path    = os.path.join(OUTPUT_DIR, f"best_{backbone_name}_fold{fold}.pth")
            torch.save(best_weights, save_path)
            print(f"    ✓ New best {best_val_acc:.2f}% → {save_path}")
        else:
            patience_ctr += 1
            if patience_ctr >= patience:
                print(f"    Early stop at epoch {epoch+1}")
                break

    return best_weights, best_val_acc


def run_training(df):
    class_weights = compute_class_weights(df)
    skf     = StratifiedKFold(n_splits=NUM_FOLDS, shuffle=True, random_state=SEED)
    labels  = df["ClassLabel"].values
    all_results = {}

    for backbone_name in BACKBONES:
        print(f"\n{'═'*60}\n  BACKBONE: {backbone_name.upper()}\n{'═'*60}")
        results = []
        for fold, (train_idx, val_idx) in enumerate(skf.split(df, labels)):
            torch.cuda.empty_cache()   # ← add this line
            w, acc = train_fold(backbone_name, fold, train_idx, val_idx,
                                df, class_weights)
            results.append((w, acc))
        accs = [r[1] for r in results]
        print(f"\n  {backbone_name.upper()} folds: {[f'{a:.1f}' for a in accs]} "
              f"| mean: {np.mean(accs):.2f}%")
        all_results[backbone_name] = results

    return all_results

def generate_submission(all_results):
    print(f"\n{'═'*60}\n  SUBMISSION — Weighted Ensemble + 10x TTA\n{'═'*60}")

    flat = [(bn, fold, w, acc)
            for bn, results in all_results.items()
            for fold, (w, acc) in enumerate(results)]

    accs        = np.array([x[3] for x in flat])
    raw_weights = np.exp(accs / 10)
    ens_weights = raw_weights / raw_weights.sum()

    ensemble_models = []
    for (bn, fold, w, acc), ew in zip(flat, ens_weights):
        m = BACKBONES[bn]()
        unwrap(m).load_state_dict(w)
        m.eval()
        ensemble_models.append((m, ew))
        print(f"  {bn} fold{fold+1}  val={acc:.2f}%  weight={ew:.4f}")

    sample    = pd.read_csv(SAMPLE_SUB)
    preds     = []
    all_probs = []

    with torch.no_grad():
        for idx, row in sample.iterrows():
            if idx % 200 == 0:
                print(f"  [{idx+1}/{len(sample)}]…")
            try:
                img = Image.open(os.path.join(TEST_DIR, row["ImageName"])).convert("RGB")
            except Exception:
                preds.append(0)
                all_probs.append([1/NUM_CLASSES]*NUM_CLASSES)
                continue
            logits = torch.zeros(1, NUM_CLASSES).to(DEVICE)

            for model, ew in ensemble_models:
                for t_idx, tfm in enumerate(TTA_TRANSFORMS):
                    if t_idx == TTA_FIVECROP_IDX:
                        crops = tfm(img).to(DEVICE)
                        with torch.amp.autocast('cuda'):
                            logits += ew * model(crops).mean(0, keepdim=True)
                    else:
                        tensor = tfm(img).unsqueeze(0).to(DEVICE)
                        with torch.amp.autocast('cuda'):
                            logits += ew * model(tensor)

            probs = F.softmax(logits, dim=1).cpu().numpy()[0]
            preds.append(logits.argmax(dim=1).item())
            all_probs.append(probs)

    pd.DataFrame({"ImageName": sample["ImageName"],
                  "ClassLabel": preds}).to_csv(
        os.path.join(OUTPUT_DIR, "submission.csv"), index=False)

    prob_df = pd.DataFrame(all_probs, columns=list(LABEL_MAP.keys()))
    prob_df.insert(0, "ImageName", sample["ImageName"])
    prob_df.to_csv(os.path.join(OUTPUT_DIR, "submission_probs.csv"), index=False)

    print(f"\n  ✓ submission.csv ({len(preds)} predictions)")
    for label, count in sorted(Counter(preds).items()):
        print(f"    {IDX_TO_CLASS[label]:25s}: {count}")

