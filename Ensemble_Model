def evaluate(all_results, df):
    print(f"\n{'═'*60}\n  EVALUATION\n{'═'*60}")
    backbone_name = list(all_results.keys())[0]
    weights, _    = max(all_results[backbone_name], key=lambda x: x[1])
    model = BACKBONES[backbone_name]()
    unwrap(model).load_state_dict(weights)
    model.eval()

    split    = int(len(df) * 0.8)
    eval_df  = df[split:].reset_index(drop=True)
    loader   = make_loader(SceneDataset(eval_df, TRAIN_DIR, val_transform),
                           BATCH_SIZE * NUM_GPUS, False)
    preds, labels_all = [], []
    with torch.no_grad():
        for imgs, lbls in loader:
            with torch.amp.autocast('cuda'):
                preds.extend(model(imgs.to(DEVICE)).argmax(1).cpu().numpy())
            labels_all.extend(lbls.numpy())

    print(f"\n  Accuracy: {accuracy_score(labels_all, preds)*100:.2f}%")
    print(classification_report(labels_all, preds, target_names=list(LABEL_MAP.keys())))

    cm = confusion_matrix(labels_all, preds)
    plt.figure(figsize=(16, 14))
    sns.heatmap(cm, annot=True, fmt="d", cmap="Blues",
                xticklabels=list(LABEL_MAP.keys()),
                yticklabels=list(LABEL_MAP.keys()))
    plt.title("Confusion Matrix")
    plt.xticks(rotation=45, ha="right")
    plt.tight_layout()
    plt.savefig(os.path.join(OUTPUT_DIR, "confusion_matrix.png"), dpi=150)
    plt.show()
