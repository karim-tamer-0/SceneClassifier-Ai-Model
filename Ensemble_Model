def generate_pseudo_labels(all_results):
    print(f"\n{'═'*60}\n  PSEUDO-LABELING (threshold={PSEUDO_CONF})\n{'═'*60}")
    sample    = pd.read_csv(SAMPLE_SUB)
    all_probs = torch.zeros(len(sample), NUM_CLASSES).to(DEVICE)
    n_models  = 0

    with torch.no_grad():
        for backbone_name, results in all_results.items():
            for (weights, _) in results:
                model = BACKBONES[backbone_name]()
                unwrap(model).load_state_dict(weights)
                model.eval()
                for idx, row in sample.iterrows():
                    try:
                        img    = Image.open(os.path.join(TEST_DIR, row["ImageName"])).convert("RGB")
                        tensor = val_transform(img).unsqueeze(0).to(DEVICE)
                        with torch.amp.autocast('cuda'):
                            all_probs[idx] += F.softmax(model(tensor), dim=1).squeeze()
                    except Exception:
                        continue
                n_models += 1

    all_probs /= n_models
    max_probs, pred_labels = all_probs.max(dim=1)
    mask      = max_probs.cpu() >= PSEUDO_CONF
    pseudo_df = pd.DataFrame({
        "ImageName":  sample["ImageName"][mask.numpy()].values,
        "ClassLabel": pred_labels.cpu()[mask].numpy()
    })
    print(f"  Pseudo-labeled {len(pseudo_df)}/{len(sample)} images")
    return pseudo_df
